# Copiar como backend/.env. No subir el archivo real a Git.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_CLAVE_PUBLICA_PUBLISHABLE_O_ANON
PORT=8080
CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200,http://127.0.0.1:7357,http://localhost:7357,http://127.0.0.1:7358
# Por defecto, issuer y JWKS se derivan de SUPABASE_URL.
# JWT_ISSUER=https://TU-PROYECTO.supabase.co/auth/v1
# JWT_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json
JWT_AUDIENCE=authenticated

# Clave SECRETA de Supabase (Settings > API Keys > secret / service_role).
# Solo en el servidor: habilita el inicio de sesión con cédula y el registro de pagos.
SUPABASE_SERVICE_KEY=TU_CLAVE_SECRETA_SB_SECRET_O_SERVICE_ROLE

# Tarifa fija por viaje en pesos colombianos.
RIDE_FARE_COP=8000

# Wompi (panel de comercio > Desarrolladores). Nunca poner estas llaves en el frontend ni en Git.
WOMPI_PUBLIC_KEY=pub_prod_xxx
WOMPI_PRIVATE_KEY=prv_prod_xxx
WOMPI_EVENTS_SECRET=prod_events_xxx
WOMPI_INTEGRITY_SECRET=prod_integrity_xxx
WOMPI_API_URL=https://production.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
# Página del frontend a la que Wompi regresa al terminar el pago (agrega ?id=<transacción>).
WOMPI_REDIRECT_URL=http://127.0.0.1:4200/pago/resultado
# URL de eventos para configurar en Wompi (debe ser HTTPS pública):
#   https://TU-API/api/payments/wompi/events
