{
  "name": "ridemove-web",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "config": "node --env-file-if-exists=.env tools/write-config.mjs",
    "start": "npm run config && ng serve --host 127.0.0.1 --port 4200",
    "build": "npm run config && ng build",
    "test": "ng test --watch=false",
    "check:types": "node tools/check-types.mjs"
  },
  "engines": { "node": "^20.19.0 || ^22.12.0 || ^24.0.0" },
  "dependencies": {
    "@angular/common": "21.2.24", "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24", "@angular/forms": "21.2.24",
    "@angular/platform-browser": "21.2.24", "@angular/router": "21.2.24",
    "rxjs": "~7.8.2", "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.24", "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.24", "typescript": "~5.9.3",
    "vitest": "^4.0.8", "jsdom": "^27.0.0"
  }
}
