{
  "info": {
    "name": "RideMove · Angular + Spring Boot",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "REST/JSON con JWT Supabase. Configura el entorno local. La carpeta de escritura modifica la BD: usar cuentas de prueba y ejecutar peticiones individualmente. El pago frontend es solo demo y no tiene endpoint."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 · Salud y seguridad sin sesión",
      "item": [
        {
          "name": "Salud pública",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Servicio disponible; no comprueba por sí solo la conexión a BD.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Viajes sin JWT → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/trips",
            "description": "Verifica que no se puede leer el negocio sin autenticación.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "JWT manipulado → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/profile",
            "description": "Debe ser rechazado antes de acceder a Supabase.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "invalid.jwt.token",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro admin rechazado → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Validación local del caso de uso; no crea cuentas.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invalid-admin@example.org\",\n  \"password\": \"example-password\",\n  \"name\": \"Prueba admin\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 · Sesión (cuenta de prueba)",
      "item": [
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Usa email y password de una cuenta existente. Guarda tokens en el entorno activo.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const session = pm.response.json();",
                  "pm.test('JWT recibido', () => pm.expect(session.access_token).to.be.a('string').and.not.empty);",
                  "if (session.access_token) pm.environment.set('accessToken', session.access_token);",
                  "if (session.refresh_token) pm.environment.set('refreshToken', session.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/refresh",
            "description": "Reemplaza también el refresh token retornado.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const session = pm.response.json();",
                  "pm.test('JWT recibido', () => pm.expect(session.access_token).to.be.a('string').and.not.empty);",
                  "if (session.access_token) pm.environment.set('accessToken', session.access_token);",
                  "if (session.refresh_token) pm.environment.set('refreshToken', session.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Revoca la sesión de renovación. Un access token puede vivir hasta su expiración.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
                  "pm.environment.unset('accessToken');",
                  "pm.environment.unset('refreshToken');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 · Dashboard y consultas",
      "item": [
        {
          "name": "Mi perfil",
          "request": {
