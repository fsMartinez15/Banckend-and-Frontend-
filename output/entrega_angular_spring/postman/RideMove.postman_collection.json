                ]
              }
            }
          ]
        },
        {
          "name": "Ubicaciones visibles",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/locations",
            "description": "Datos autorizados por rol y viaje."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 · Escritura manual en datos de prueba",
      "description": "Estas peticiones crean cuentas o modifican datos reales del ambiente elegido. No ejecutar en bloque sobre usuarios reales.",
      "item": [
        {
          "name": "Registrar cuenta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Puede requerir confirmación de correo. Ejecuta una vez con una cuenta de prueba controlada.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"{{registrationRole}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const session = pm.response.json();",
                  "if (session.access_token) pm.environment.set('accessToken', session.access_token);",
                  "if (session.refresh_token) pm.environment.set('refreshToken', session.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Solicitar viaje",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/trips",
            "description": "Pasajero activo sin otro viaje activo. Respuesta 201 sin cuerpo. Consulta Viajes visibles y copia el id creado a tripId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": \"{{origin}}\",\n  \"destination\": \"{{destination}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cambiar estado",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/trips/{{tripId}}/status",
            "description": "pending→accepted (conductor disponible), accepted→in_progress→completed (conductor asignado), pending→cancelled (pasajero autor).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"{{targetStatus}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar viaje",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/trips/{{tripId}}/rejections",
            "description": "Conductor; no cancela el viaje para los demás conductores.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Calificar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/trips/{{tripId}}/rating",
            "description": "Pasajero autor, viaje completado, una sola vez.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Prueba de aceptación\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar mi perfil",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/profile",
            "description": "Solo nombre y teléfono del actor.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"phone\": \"{{phone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Activar disponibilidad",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/availability",
            "description": "Conductor activo, sujeto a reglas de vehículo y viaje.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"available\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Guardar vehículo",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/vehicle",
            "description": "Conductor: completa valores de prueba y userId desde Mi perfil.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driver_id\": \"{{userId}}\",\n  \"plate\": \"{{plate}}\",\n  \"brand\": \"{{brand}}\",\n  \"model\": \"{{model}}\",\n  \"color\": \"{{color}}\",\n  \"license\": \"{{license}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Enviar ubicación",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/location",
            "description": "Conductor disponible. Coordenadas públicas de ejemplo en Fusagasugá.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 4.3365,\n  \"longitude\": -74.3638\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Suspender usuario de prueba",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/profiles/{{targetUserId}}/access",
            "description": "Solo administrador. Usar un targetUserId de prueba; afecta acceso del usuario.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
